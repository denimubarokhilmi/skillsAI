 return {m,body:b};
}

async function save(name, fn){ const {m,body}=fn(); const doc=e.assemble(m,body); const out=path.join(__dirname,'..','output',name+'.docx'); await e.save(doc,out); return out; }
(async()=>{ for(const [n,f] of [['UserManual_Admin_Sitiwinangun_FINAL',admin],['UserManual_Storytelling_Sitiwinangun_FINAL',story],['UserManual_VirtualTour360_Sitiwinangun_FINAL',vt]]) console.log(await save(n,f)); })();





