 renderTasks(b,[
  {title:'Masuk ke Dashboard',desc:'Login ke panel admin.',screenshot:'admin_01_login.png',steps:[['Buka /admin/login.','Form email/password tampil.'],['Isi email admin.','Field email terisi.'],['Isi password admin.','Field password terisi.'],['Klik Masuk ke Dashboard.','Dashboard admin terbuka.']]},
