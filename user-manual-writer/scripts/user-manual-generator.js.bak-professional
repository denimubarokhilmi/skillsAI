const e = require('../../_shared/docx-engine');
const { ImageRun, Paragraph, AlignmentType } = require('docx');
const fs = require('fs');
const path = require('path');

const TODAY = '29 Juni 2026';
const AUTHOR = 'Tim Dokumentasi Website Desa Sitiwinangun';
const ORG = 'Program TPLM – Universitas Telkom';
const OUT = path.join(__dirname, '..', 'output');
const SHOTS = 'C:/Users/LEGION/Documents/Codex/2026-06-27/bu/outputs/screenshots_manual_validation';
const W = e.DXA.CONTENT_W;
if (!fs.existsSync(OUT)) fs.mkdirSync(OUT, { recursive: true });

function meta(title, role) { return { title, subtitle:'Website Desa Sitiwinangun', role, version:'1.0', date:TODAY, author:AUTHOR, organization:ORG, filename:title.replace(/[^a-zA-Z0-9_]/g,'_') }; }
function rev() { return [{ version:'1.0', date:TODAY, author:AUTHOR, description:'Final berdasarkan validasi UI dan screenshot Playwright' }]; }
function tbl(headers, rows, defs, cap) { return [e.tbl({ headers, rows, columnDefs:defs }), ...(cap?[e.tblCaption(cap)]:[])]; }
function proc(rows, cap) { return tbl(['No','Aksi Pengguna','Hasil Sistem'], rows.map((r,i)=>[String(i+1), r[0], r[1]]), [{w:600,align:'center'},{w:4200,align:'left'},{w:W-4800,align:'left'}], cap); }
function pngSize(file){ const b=fs.readFileSync(file); return {width:b.readUInt32BE(16), height:b.readUInt32BE(20)}; }
function shot(title, file){
  if(!file) return [];
  const full=path.join(SHOTS,file);
  const blocks=[];
  if(!fs.existsSync(full)) return [e.p('Screenshot tidak ditemukan: '+full), e.figCaption(title)];
  const s=pngSize(full); let width=500, height=Math.round(width/(s.width/s.height));
  if(height>650){height=650;width=Math.round(height*(s.width/s.height));}
  blocks.push(new Paragraph({alignment:AlignmentType.CENTER,children:[new ImageRun({data:fs.readFileSync(full),transformation:{width,height},type:'png'})]}));
  blocks.push(e.figCaption(title));
  return blocks;
}
function front(m){ return [...e.cover(m), ...e.revisionHistory(rev()), ...e.tocSection(), e.br()]; }
function conventions(){ return [e.h(0,'Konvensi Dokumen'), ...tbl(['Format / Simbol','Arti'], [['Teks tebal','Nama menu/tombol/field UI'],['Monospace','URL/path/file'],['CATATAN','Informasi tambahan'],['PERINGATAN','Tindakan perlu hati-hati']], [{w:3000,align:'left'},{w:W-3000,align:'left'}], 'Konvensi Penulisan')]; }
function requirements(rows){ return [e.h(0,'Persyaratan Sistem'), ...tbl(['Komponen','Kebutuhan'], rows, [{w:3000,align:'left'},{w:W-3000,align:'left'}], 'Persyaratan Sistem')]; }
function renderTasks(b,tasks){ for(const t of tasks){ b.push(e.h(1,t.title), e.p(t.desc), ...proc(t.steps,t.title), ...shot(t.title,t.screenshot)); if(t.note) b.push(e.p('CATATAN: '+t.note)); } }
function finishCommon(b, type){ b.push(e.h(0,'Troubleshooting'), ...tbl(['Masalah','Penyebab','Solusi'], type.trouble, [{w:2800,align:'left'},{w:2800,align:'left'},{w:W-5600,align:'left'}], 'Troubleshooting')); b.push(e.h(0,'Glosarium'), ...tbl(['Istilah','Definisi'], type.glossary, [{w:2500,align:'left'},{w:W-2500,align:'left'}], 'Glosarium')); b.push(e.h(0,'FAQ'), ...tbl(['Pertanyaan','Jawaban'], type.faq, [{w:3500,align:'left'},{w:W-3500,align:'left'}], 'FAQ')); }

