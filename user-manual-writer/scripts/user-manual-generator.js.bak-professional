  {title:'Mengelola Jelajah Desa',desc:'Kelola lokasi/rumah produksi.',screenshot:'admin_11_locations_index.png',steps:[['Klik Jelajah Desa.','Daftar lokasi tampil.'],['Klik Tambah/Edit.','Form lokasi tampil.'],['Isi detail lokasi.','Data siap.'],['Klik Simpan.','Lokasi tersimpan.']]},
