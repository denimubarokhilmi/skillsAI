  {title:'Mengelola Kisah Kriya',desc:'Kelola narasi storytelling.',screenshot:'admin_15_storytelling.png',steps:[['Klik Kisah Kriya.','Editor narasi tampil.'],['Ubah Bab II sampai Bab V.','Narasi siap.'],['Klik Simpan Perubahan.','Storytelling publik diperbarui.']]},
