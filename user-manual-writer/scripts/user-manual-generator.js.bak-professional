  {title:'Melihat Daftar Koleksi Kriya',desc:'Mencari dan melihat koleksi.',screenshot:'admin_03_collections_index.png',steps:[['Klik Koleksi Kriya.','Daftar koleksi tampil.'],['Gunakan search/filter.','Data difilter.'],['Klik Tambah Koleksi.','Form tambah terbuka.']]},
  {title:'Menambah Koleksi Kriya',desc:'Membuat data koleksi gerabah atau pola motif.',screenshot:'admin_04_collections_create.png',steps:[['Pilih Tipe Galeri.','Koleksi Gerabah/Pola Motif terpilih.'],['Isi Nama Motif/Objek dan URL Slug.','Identitas koleksi terisi.'],['Pilih Kategori Kriya, Tahun, Status Publikasi.','Metadata terisi.'],['Isi Deskripsi Singkat, Sejarah & Asal-usul, Makna Filosofis, Teknik Produksi, Bahan Pembuatan.','Narasi koleksi terisi.'],['Upload Gambar.','File gambar terpilih.'],['Pilih Pengrajin Pembuat dan isi Lokasi Pembuatan.','Relasi pengrajin/lokasi terisi.'],['Klik Simpan.','Data disimpan; jika automation gagal, lakukan submit manual.']]},
  {title:'Mengubah Koleksi Kriya',desc:'Mengedit data koleksi existing.',screenshot:'admin_05_collections_edit.png',steps:[['Klik Edit pada koleksi.','Form edit berisi data lama.'],['Ubah field yang diperlukan.','Data diperbarui di form.'],['Gunakan Ganti Gambar jika perlu.','Gambar baru siap.'],['Klik Simpan.','Data koleksi diperbarui.']]},
  {title:'Mengelola Kisah Pengrajin',desc:'Kelola data pengrajin.',screenshot:'admin_06_artisans_index.png',steps:[['Klik Kisah Pengrajin.','Daftar pengrajin tampil.'],['Klik Tambah Baru/Edit.','Form pengrajin tampil.'],['Isi nama, deskripsi, foto, kontak.','Data siap.'],['Klik Simpan.','Data tersimpan.']]},
